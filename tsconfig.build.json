{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2024", "ESNext.Disposable"],
    "types": ["node"],
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "client/index.ts",
    "protocol/sdk.ts",
    "protocol/node.ts",
    "client/*.d.ts"
  ]
}
