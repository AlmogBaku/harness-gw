{
  "name": "@harness-gw/sdk",
  "version": "0.1.2",
  "description": "A gateway that puts Hermes, OpenClaw, and OpenCode behind one ACP WebSocket, and the browser client and protocol SDK for it.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/sdk.d.ts",
      "import": "./dist/protocol/sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlmogBaku/harness-gw.git"
  },
  "scripts": {
    "gateway": "bun run src/cli.ts",
    "serve": "bun run src/cli.ts serve",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc -p tsconfig.gateway.json && tsc -p tsconfig.gateway-tests.json && tsc -p tsconfig.lifecycle.json && tsc -p tsconfig.client.json && tsc -p tsconfig.client-tests.json",
    "test": "vitest run --project !gate",
    "test:gate": "vitest run --project gate",
    "test:bun": "bun test ./src/cli.bun-spec.ts ./src/server.bun-spec.ts ./src/shutdown.bun-spec.ts",
    "test:watch": "vitest --project !gate",
    "build": "rm -rf dist && bun build client/index.ts protocol/sdk.ts --root . --outdir dist --splitting --format esm --target browser --packages external --chunk-naming 'chunks/[name].[ext]' && tsc -p tsconfig.build.json && bun scripts/declaration-extensions.mjs dist"
  },
  "dependencies": {
    "cockatiel": "4.0.0",
    "pino": "10.3.1",
    "xstate": "5.33.2"
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@eslint/js": "9",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openclaw/gateway-client": "2026.9.4",
    "@openclaw/gateway-protocol": "2026.9.4",
    "@opencode-ai/sdk": "1.18.29",
    "@types/bun": "^1.4.1",
    "@types/ms": "2.1.0",
    "@types/node": "^20",
    "commander": "14.0.3",
    "eslint": "^9",
    "globals": "^17.12.0",
    "hono": "4.13.5",
    "ipaddr.js": "^2.5.0",
    "jose": "6.2.12",
    "ms": "2.1.3",
    "prettier": "^3.8.3",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  }
}
